{
  "name": "solar-duo",
  "productName": "Solar Duo",
  "version": "1.0.0",
  "description": "Dimensionnement d'installations photovoltaïques (sites isolés et raccordés au réseau)",
  "main": "main.js",
  "author": "Jacques Branas <deltapassion@users.noreply.github.com>",
  "license": "GPL-3.0-or-later",
  "homepage": "https://deltapassion.github.io/Solar-Duo/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deltapassion/Solar-Duo.git"
  },
  "scripts": {
    "start": "electron .",
    "build:html": "python3 tools/build.py",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.deltapassion.solarduo",
    "productName": "Solar Duo",
    "copyright": "© Jacques Branas — GPL v3",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "build/icon.png",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "fileAssociations": [
      {
        "ext": "solarduo",
        "name": "Projet Solar Duo",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Solar-Duo-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Solar Duo",
      "artifactName": "Solar-Duo-Windows-Setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "target": [
        "dir"
      ],
      "identity": null,
      "hardenedRuntime": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education;Science;Engineering",
      "maintainer": "Jacques Branas",
      "synopsis": "Dimensionnement d'installations photovoltaïques",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "artifactName": "Solar-Duo-Linux-x86_64.${ext}"
    },
    "appImage": {
      "artifactName": "Solar-Duo-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "solar-duo_amd64.${ext}"
    }
  }
}
